  "stages": [
    {
      "id": "frame",
      "number": 1,
      "name": "Frame the problem",
      "question": "What are we predicting, and what counts as good?",
      "description": "Say what we are predicting and what counts as a good answer, so we know the score to beat."
    },
    {
      "id": "prepare",
      "number": 2,
      "name": "Prepare the data",
      "question": "Is the data clean and in a usable form?",
      "description": "Clean the data and turn what was recorded into measurements a model can use."
    },
    {
      "id": "understand",
      "number": 3,
      "name": "Understand the data",
      "question": "What patterns are there?",
      "description": "Look for patterns in the data before fitting anything."
    },
    {
      "id": "split",
      "number": 4,
      "name": "Split the data",
      "question": "What do we learn from, choose with, and mark on?",
      "description": "Set aside data to learn from, data to choose with, and data to mark the final answer on."
    },
    {
      "id": "fit",
      "number": 5,
      "name": "Fit the model",
      "question": "What are the best parameters for this setup?",
      "description": "For one chosen setup, find the parameters that fit the learning data best."
    },
    {
      "id": "choose",
      "number": 6,
      "name": "Choose the setup",
      "question": "Which features, model type and hyperparameters?",
      "description": "Decide which features, model type and hyperparameters to use, judged on data the fit never saw."
    },
    {
      "id": "assess",
      "number": 7,
      "name": "Final assessment",
      "question": "How good is it on data it has never seen?",
      "description": "Score the chosen model once, on data it has never seen."
    },
    {
      "id": "interpret",
      "number": 8,
      "name": "Interpret and communicate",
      "question": "What does it mean?",
      "description": "Explain in plain words what the result means."
    }
  ],
  "loop": {
    "fit": "fit",
    "choose": "choose"
  },
  "notes": {
    "general": "Every time the agent tries a new setup (stage 6) it fits the model again (stage 5), so the two stages form a loop. Parameters are learned from the training years (2005 to 2024). The setup is chosen using the validation year (2025). The test year (2026) is used once, at the end.",
    "stages": {
      "choose": "In this app, Choose the setup means feature selection only. Plain linear regression has no hyperparameters to tune; hyperparameter tuning appears in later apps."
    }
  },
