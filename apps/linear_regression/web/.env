# Public address of the main "Explain Machine Learning in Cricket Terms" site (not a secret).
# Used for the link above the headline. To change it without editing code, set VITE_SITE_URL
# in the Vercel project's Environment Variables and redeploy; that value overrides this file.
VITE_SITE_URL=https://explain-machine-learning-in-cricket.vercel.app/

# This app's own public address, for the link preview (og:url). The owner sets it (here, or in the Vercel project's Environment
# Variables). While it still says CHANGE-ME, `uv run pytest -m release` fails.
VITE_APP_URL=https://CHANGE-ME.invalid/
